      "plt": "square-exact.plt",
      "expectation": "exact",
      "note": "axis-aligned rectangle, no simplification, no ramps",
      "config": {
        "kernel-shape": "morph_ellipse",
        "filtered-min-area": 1,
        "circle-fitting": {
          "enabled": false,
          "circularity-threshold": 0.03,
          "num-of-edges": 32
        },
        "douglas-peucker": {
          "enabled": false,
          "min-epsilon": 0.0001,
          "max-epsilon": 0.001,
          "steps": 0,
          "complexity": {
            "circumference": 0.6,
            "curvature": 0.1,
            "convexity": 0.3,
            "gradient": 0.5
          }
        },
        "visvalingam-whyatt": {
          "enabled": false,
          "max-area": 15
        },
        "extension": {
          "enabled": false,
          "inner-enabled": false,
          "max-degree": 45,
          "max-length": 1.5,
          "steps": 3
        },
        "image": {
          "margin": 0,
          "fill-method": "fit",
          "scale-ratio": 1.0,
          "binary": {
            "method": "thresholding",
            "png-thresholding": true,
            "threshold": 240,
            "gaussian-blur": {
              "enabled": false,
              "kernel-size": [
                9,
                9
              ]
            }
          }
        },
        "contours": {
          "internal": false,
          "inner-direction": "clockwise",
          "outter-direction": "origin"
        }
      },
      "dilation": 0.0,
      "angle": 0.0,
      "mediaType": 2030,
      "kp": 1.0
    },
